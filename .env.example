# Local Docker MongoDB only. Generate a long unique alphanumeric password.
MONGO_INITDB_ROOT_USERNAME=tenx
MONGO_INITDB_ROOT_PASSWORD=replace-with-a-long-random-password
MONGO_APP_USERNAME=tenx_app
MONGO_APP_PASSWORD=replace-with-a-different-random-password-of-32-plus-characters
# Local Node development connects via 127.0.0.1:27017; Compose overrides the host.
MONGO_URI=mongodb://tenx_app:replace-with-a-different-random-password-of-32-plus-characters@127.0.0.1:27017/tenx?authSource=tenx
# Exact browser origin; production must use the public HTTPS origin.
APP_ORIGIN=http://localhost:5173
# Compose HTTP entrypoint for local validation. Put a TLS reverse proxy in front in production.
WEB_PORT=8080
